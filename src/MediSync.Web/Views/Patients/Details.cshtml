@model Patient
@{ ViewData["Title"] = "Patient Details"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><span class="eyebrow">PATIENT</span><h1>@Model.FullName</h1></div>@if(User.IsInRole("Admin")||User.IsInRole("Receptionist")){<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>}</div>
<div class="row g-4"><div class="col-lg-4"><div class="form-card"><p><strong>DOB:</strong> @Model.DateOfBirth.ToString("dd MMM yyyy")</p><p><strong>Gender:</strong> @Model.Gender</p><p><strong>Phone:</strong> @Model.Phone</p><p><strong>Email:</strong> @Model.Email</p><p><strong>Emergency:</strong> @Model.EmergencyContact</p><p class="mb-0"><strong>Address:</strong> @Model.Address</p></div></div><div class="col-lg-8"><div class="table-card p-3"><h4>Recent Appointments</h4>@foreach(var a in Model.Appointments.OrderByDescending(a=>a.AppointmentDate).Take(8)){<div class="timeline-row"><span>@a.AppointmentDate.ToString("dd MMM yyyy HH:mm")</span><span>@a.Doctor.FullName</span><span class="badge bg-secondary">@a.Status</span></div>}</div></div></div>
