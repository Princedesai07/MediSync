@model Patient
@{ ViewData["Title"] = "My Profile"; }
<h1>My Profile</h1><form asp-action="Profile" method="post" class="form-card"><input asp-for="Id" type="hidden"/><input asp-for="FirstName" type="hidden"/><input asp-for="LastName" type="hidden"/><input asp-for="DateOfBirth" type="hidden"/><input asp-for="Gender" type="hidden"/><input asp-for="RegistrationDate" type="hidden"/><div class="row"><div class="col-md-6 mb-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" disabled/></div><div class="col-md-6 mb-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" disabled/></div></div><div class="mb-3"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control"/></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div><div class="mb-3"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control"></textarea></div><div class="mb-3"><label asp-for="EmergencyContact" class="form-label"></label><input asp-for="EmergencyContact" class="form-control"/></div><button class="btn btn-primary">Update Profile</button></form>
