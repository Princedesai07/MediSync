@model IEnumerable<Prescription>
@{ ViewData["Title"] = "Prescriptions"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Prescriptions</h1><p class="text-muted">Doctor → Pharmacy → Medicine stock.</p>@if(User.IsInRole("Doctor")){<small class="text-muted">Create prescriptions from the relevant Medical Record.</small>}</div>@if(User.IsInRole("Admin")){<a class="btn btn-primary" asp-action="Create">Create Prescription</a>}</div>
@if(TempData["Message"] is not null){<div class="alert alert-success">@TempData["Message"]</div>}
@if(TempData["Error"] is not null){<div class="alert alert-danger">@TempData["Error"]</div>}
@foreach(var p in Model){<div class="form-card mb-3"><div class="d-flex justify-content-between align-items-start"><div><h4>#@p.Id · @p.Patient.FullName</h4><div class="text-muted">@p.CreatedDate.ToString("dd MMM yyyy") · @p.Doctor.FullName@if(p.MedicalRecordId.HasValue){<span> · Record #@p.MedicalRecordId</span>}</div></div><span class="badge bg-@(p.Status == PrescriptionStatus.Dispensed ? "success" : p.Status == PrescriptionStatus.Processing ? "warning text-dark" : "secondary")">@p.Status</span></div><hr/><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Medicine</th><th>Dosage</th><th>Frequency</th><th>Duration</th><th>Qty</th>@if(User.IsInRole("Pharmacist")||User.IsInRole("Admin")){<th>Stock</th>}</tr></thead><tbody>@foreach(var i in p.Items){<tr><td>@i.Medicine.Name</td><td>@i.Dosage</td><td>@i.Frequency</td><td>@i.Duration</td><td>@i.Quantity</td>@if(User.IsInRole("Pharmacist")||User.IsInRole("Admin")){<td><span class="badge @(i.Medicine.StockQuantity <= i.Medicine.LowStockThreshold ? "text-bg-danger" : "text-bg-success")">@i.Medicine.StockQuantity</span></td>}</tr>}</tbody></table></div>@if(!string.IsNullOrWhiteSpace(p.Instructions)){<p><strong>Instructions:</strong> @p.Instructions</p>}
@if(User.IsInRole("Pharmacist")||User.IsInRole("Admin")){<div class="d-flex gap-2">@if(p.Status == PrescriptionStatus.Pending){<form asp-action="StartProcessing" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-outline-primary">Start Processing</button></form>} @if(p.Status == PrescriptionStatus.Processing){<form asp-action="Dispense" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-primary">Dispense & Update Stock</button></form>}</div>}</div>}
