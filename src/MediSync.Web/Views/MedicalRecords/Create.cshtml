@model MedicalRecordCreateViewModel
@{ ViewData["Title"] = "Create Medical Record"; }
<h1>Create Medical Record</h1><p class="text-muted">Only completed appointments can create a clinical record.</p><form asp-action="Create" method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="AppointmentId" class="form-label">Completed Appointment</label><select asp-for="AppointmentId" asp-items="Model.Appointments" class="form-select"><option value="">Select appointment</option></select></div><div class="mb-3"><label asp-for="Symptoms" class="form-label"></label><textarea asp-for="Symptoms" class="form-control" rows="3"></textarea></div><div class="mb-3"><label asp-for="Diagnosis" class="form-label"></label><textarea asp-for="Diagnosis" class="form-control" rows="3"></textarea></div><div class="mb-3"><label asp-for="DoctorNotes" class="form-label"></label><textarea asp-for="DoctorNotes" class="form-control" rows="3"></textarea></div><div class="mb-3"><label asp-for="FollowUpInstructions" class="form-label"></label><textarea asp-for="FollowUpInstructions" class="form-control" rows="3"></textarea></div><button class="btn btn-primary">Save Record</button></form>
