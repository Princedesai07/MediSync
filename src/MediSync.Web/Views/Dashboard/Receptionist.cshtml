@model DashboardViewModel
@{ ViewData["Title"] = "Receptionist Dashboard"; }
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><span class="eyebrow">FRONT DESK</span><h1 class="mb-1">Receptionist Dashboard</h1><p class="text-muted mb-0">Patient registration and appointment coordination.</p></div><div class="d-flex gap-2"><a class="btn btn-primary" asp-controller="Patients" asp-action="Create">Register Patient</a><a class="btn btn-outline-primary" asp-controller="Appointments" asp-action="Create">Book Appointment</a></div></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="stat-card"><div class="stat-label">Today's Appointments</div><div class="stat-value">@Model.TodaysAppointments</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Patients</div><div class="stat-value">@Model.TotalPatients</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Pending</div><div class="stat-value">@Model.PendingAppointments</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Upcoming</div><div class="stat-value">@Model.UpcomingAppointments</div></div></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="form-card h-100"><div class="section-label">FRONT DESK WORKFLOW</div><h3 class="mt-1">Daily Operations</h3><div class="workflow"><div>Register</div><span>→</span><div>Book</div><span>→</span><div>Pending</div><span>→</span><div>Confirmed</div></div></div></div><div class="col-lg-5"><div class="form-card h-100"><div class="section-label">QUICK ACCESS</div><h3 class="mt-1">Manage</h3><div class="d-grid gap-2 mt-3"><a class="quick-link" asp-controller="Patients" asp-action="Index"><span>Patient Registry</span><span>→</span></a><a class="quick-link" asp-controller="Appointments" asp-action="Index"><span>Appointment Schedule</span><span>→</span></a></div></div></div></div>
