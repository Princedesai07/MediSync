@model AppointmentCreateViewModel
@{ ViewData["Title"] = "Create Appointment"; }
<div class="mb-4"><span class="eyebrow">SCHEDULING</span><h1>Create Appointment</h1><p class="text-muted">New appointments start as <strong>Pending</strong> and are reviewed by the doctor.</p></div>
<form asp-action="Create" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="PatientId" class="form-label">Patient</label>
            @if (!string.IsNullOrWhiteSpace(Model.PatientName))
            {
                <input class="form-control" value="@Model.PatientName" disabled />
                <input type="hidden" asp-for="PatientId" />
                <div class="form-text">Patients can only book appointments for themselves.</div>
            }
            else
            {
                <select asp-for="PatientId" asp-items="Model.Patients" class="form-select"><option value="">Select patient</option></select>
            }
            <span asp-validation-for="PatientId" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="DoctorId" class="form-label">Doctor</label>
            <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select"><option value="">Select doctor</option></select>
            <span asp-validation-for="DoctorId" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="AppointmentDay" class="form-label">Appointment Date</label>
            <input asp-for="AppointmentDay" type="date" class="form-control" />
            <span asp-validation-for="AppointmentDay" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="AppointmentTime" class="form-label">Time</label>
            <select asp-for="AppointmentTime" class="form-select">
                @for (var hour = 0; hour < 24; hour++)
                {
                    for (var minute = 0; minute < 60; minute += 15)
                    {
                        var value = $"{hour:00}:{minute:00}";
                        <option value="@value">@DateTime.Today.AddHours(hour).AddMinutes(minute).ToString("hh:mm tt")</option>
                    }
                }
            </select>
            <span asp-validation-for="AppointmentTime" class="text-danger"></span>
            <div class="form-text">Appointments are available in 15-minute slots.</div>
        </div>
        <div class="col-md-6">
            <label asp-for="Reason" class="form-label">Reason / Details</label>
            <input asp-for="Reason" class="form-control" placeholder="e.g. Follow-up consultation" />
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Create Appointment</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
