@model Doctor
@{ ViewData["Title"] = "Doctor Details"; }
<div class="form-card"><span class="eyebrow">DOCTOR</span><h1>@Model.FullName</h1><p class="lead">@Model.Specialization</p><p>@Model.Department · @Model.Availability</p><p>@Model.Email · @Model.Phone</p>@if(User.IsInRole("Admin")){<a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>}</div>
