@model DashboardViewModel
@{ ViewData["Title"] = "Pharmacist Dashboard"; }
<div class="mb-4"><span class="eyebrow">PHARMACY OPERATIONS</span><h1 class="mb-1">Pharmacist Dashboard</h1><p class="text-muted mb-0">Manage the prescription queue and medicine inventory.</p></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="stat-card"><div class="stat-label">Pending Prescriptions</div><div class="stat-value">@Model.PendingPrescriptions</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Processing</div><div class="stat-value">@Model.ProcessingPrescriptions</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Medicines</div><div class="stat-value">@Model.TotalMedicines</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Low Stock</div><div class="stat-value">@Model.LowStockMedicines</div></div></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="form-card h-100"><div class="section-label">PHARMACY WORKFLOW</div><h3 class="mt-1">Prescription Queue</h3><p class="text-muted">Review prescriptions, verify medicine availability, then dispense and update stock.</p><div class="workflow"><div>Pending</div><span>→</span><div>Processing</div><span>→</span><div>Dispensed</div></div><a class="btn btn-primary" asp-controller="Prescriptions" asp-action="Index">Open Prescriptions</a></div></div><div class="col-lg-5"><div class="form-card h-100"><div class="section-label">INVENTORY</div><h3 class="mt-1">Medicine Stock</h3><div class="row g-3 mt-1"><div class="col-6"><div class="profile-field"><span>Low Stock</span><strong>@Model.LowStockMedicines</strong></div></div><div class="col-6"><div class="profile-field"><span>Expired</span><strong>@Model.ExpiredMedicines</strong></div></div></div><a class="btn btn-outline-primary mt-3" asp-controller="Medicines" asp-action="Index">Open Medicine Inventory</a></div></div></div>
