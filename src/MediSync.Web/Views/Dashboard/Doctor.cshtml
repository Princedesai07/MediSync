@model DashboardViewModel
@{ ViewData["Title"] = "Doctor Dashboard"; }
<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4"><div><span class="eyebrow">CLINICAL WORKSPACE</span><h1 class="mb-1">Doctor Dashboard</h1><p class="text-muted mb-0">Your appointments, relevant patients, clinical records and care workflows.</p></div><a class="btn btn-primary" asp-controller="Appointments" asp-action="Index">Open My Appointments</a></div>
<div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-label">Today's Appointments</div><div class="stat-value">@Model.TodaysAppointments</div></div></div><div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-label">Pending</div><div class="stat-value">@Model.PendingAppointments</div></div></div><div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-label">Relevant Patients</div><div class="stat-value">@Model.TotalPatients</div></div></div><div class="col-sm-6 col-xl-3"><div class="stat-card"><div class="stat-label">Upcoming</div><div class="stat-value">@Model.UpcomingAppointments</div></div></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="stat-card"><div class="stat-label">Pending Lab Work</div><div class="stat-value">@Model.PendingLabTests</div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-label">Medical Records</div><div class="stat-value">@Model.TotalMedicalRecords</div></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-label">Prescriptions</div><div class="stat-value">@Model.TotalPrescriptions</div></div></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="form-card h-100"><div class="section-label">CLINICAL WORKFLOW</div><h3 class="mt-1">Care Journey</h3><div class="workflow"><div>Appointment</div><span>→</span><div>Consultation</div><span>→</span><div>Medical Record</div><span>→</span><div>Lab / Prescription</div></div></div></div><div class="col-lg-5"><div class="form-card h-100"><div class="section-label">QUICK ACCESS</div><h3 class="mt-1">Clinical Work</h3><div class="d-grid gap-2 mt-3"><a class="quick-link" asp-controller="MedicalRecords" asp-action="Index"><span>Medical Records</span><span>→</span></a><a class="quick-link" asp-controller="LabTests" asp-action="Index"><span>Laboratory Results</span><span>→</span></a><a class="quick-link" asp-controller="Prescriptions" asp-action="Index"><span>Prescriptions</span><span>→</span></a></div></div></div></div>
