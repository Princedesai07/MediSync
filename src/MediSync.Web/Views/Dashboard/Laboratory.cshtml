@model DashboardViewModel
@{ ViewData["Title"] = "Laboratory Dashboard"; }
<div class="mb-4"><span class="eyebrow">LAB OPERATIONS</span><h1 class="mb-1">Laboratory Dashboard</h1><p class="text-muted mb-0">Process requests and publish results.</p></div>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="stat-card"><div class="stat-label">Pending Tests</div><div class="stat-value">@Model.PendingLabTests</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">In Progress</div><div class="stat-value">@Model.InProgressLabTests</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Completed Tests</div><div class="stat-value">@Model.CompletedLabTests</div></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">Requested Today</div><div class="stat-value">@Model.TodaysAppointments</div></div></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="form-card h-100"><div class="section-label">LAB WORKFLOW</div><h3 class="mt-1">Test Processing</h3><div class="workflow"><div>Requested</div><span>→</span><div>In Progress</div><span>→</span><div>Completed</div></div><a class="btn btn-primary mt-3" asp-controller="LabTests" asp-action="Index">Open Laboratory Queue</a></div></div><div class="col-lg-5"><div class="form-card h-100"><div class="section-label">RESPONSIBILITY</div><h3 class="mt-1">Laboratory Only</h3><p class="text-muted">Enter results and report notes for requested tests. Clinical diagnoses and prescriptions remain outside the laboratory role.</p></div></div></div>
