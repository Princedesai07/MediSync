@model IEnumerable<MedicalRecord>
@{ ViewData["Title"] = "Medical Records"; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><h1>Medical Records</h1><p class="text-muted">Clinical history connected to completed consultations.</p></div>@if(User.IsInRole("Admin")||User.IsInRole("Doctor")){<a class="btn btn-primary" asp-action="Create">Create Record</a>}</div><div class="row g-3">@foreach(var r in Model){<div class="col-lg-6"><div class="form-card h-100"><h4>@r.Patient.FullName</h4><div class="text-muted">@r.VisitDate.ToString("dd MMM yyyy") · @r.Doctor.FullName</div><hr/><p><strong>Symptoms:</strong> @r.Symptoms</p><p><strong>Diagnosis:</strong> @r.Diagnosis</p><p><strong>Notes:</strong> @r.DoctorNotes</p><p><strong>Follow-up:</strong> @r.FollowUpInstructions</p><div class="mt-3">@if(User.IsInRole("Doctor")){<a class="btn btn-sm btn-outline-primary" asp-controller="LabTests" asp-action="Create" asp-route-medicalRecordId="@r.Id">Request Lab Test</a> <a class="btn btn-sm btn-outline-success" asp-controller="Prescriptions" asp-action="Create" asp-route-medicalRecordId="@r.Id">Create Prescription</a>}</div></div></div>}</div>
