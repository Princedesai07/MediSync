@model IEnumerable<Patient>
@{ ViewData["Title"] = "Patients"; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="eyebrow">PATIENT REGISTRY</span><h1 class="mb-1">Patients</h1><p class="text-muted mb-0">Central patient registry with role-scoped access.</p></div>@if(User.IsInRole("Admin")||User.IsInRole("Receptionist")){<a class="btn btn-primary" asp-action="Create">+ Register Patient</a>}</div>
<form method="get" class="form-card mb-4"><div class="row g-3 align-items-end"><div class="col-md-7"><label class="form-label">Search</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Patient name, phone or email" /></div><div class="col-md-4"><label class="form-label">Gender</label><select name="gender" class="form-select"><option value="">All genders</option><option value="Male" selected="@(ViewBag.Gender == "Male" ? "selected" : null)">Male</option><option value="Female" selected="@(ViewBag.Gender == "Female" ? "selected" : null)">Female</option><option value="Other" selected="@(ViewBag.Gender == "Other" ? "selected" : null)">Other</option></select></div><div class="col-md-1"><button class="btn btn-primary w-100">Go</button></div></div></form>
<div class="table-card"><table class="table table-hover align-middle mb-0"><thead><tr><th>Patient</th><th>Gender</th><th>Phone</th><th>Email</th><th>Registered</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.FullName</strong></td><td>@p.Gender</td><td>@p.Phone</td><td>@p.Email</td><td>@p.RegistrationDate.ToString("dd MMM yyyy")</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@p.Id">View</a>@if(User.IsInRole("Admin")||User.IsInRole("Receptionist")){<a class="btn btn-sm btn-outline-secondary ms-1" asp-action="Edit" asp-route-id="@p.Id">Edit</a>}</td></tr>}@if(!Model.Any()){<tr><td colspan="6" class="text-center py-5 text-muted">No patients found.</td></tr>}</tbody></table></div>
