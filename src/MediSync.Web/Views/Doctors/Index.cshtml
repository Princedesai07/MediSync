@model IEnumerable<Doctor>
@{ ViewData["Title"] = "Doctors"; }
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><span class="eyebrow">CLINICAL DIRECTORY</span><h1 class="mb-1">Doctors</h1><p class="text-muted mb-0">Search and manage the MediSync clinical team.</p></div>@if(User.IsInRole("Admin")){<a class="btn btn-primary" asp-action="Create">+ Add Doctor</a>}</div>
<form method="get" class="form-card mb-4"><div class="row g-3 align-items-end"><div class="col-md-7"><label class="form-label">Search</label><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Doctor name, specialty or email" /></div><div class="col-md-4"><label class="form-label">Specialization</label><select name="specialization" class="form-select"><option value="">All specializations</option>@foreach(var s in (IEnumerable<string>)ViewBag.Specializations){<option value="@s" selected="@(ViewBag.Specialization == s ? "selected" : null)">@s</option>}</select></div><div class="col-md-1"><button class="btn btn-primary w-100">Go</button></div></div></form>
<div class="row g-3">@foreach(var d in Model){<div class="col-md-6 col-xl-4"><div class="form-card h-100"><div class="d-flex justify-content-between gap-2"><h4 class="mb-1">@d.FullName</h4><span class="badge text-bg-light">@d.Specialization</span></div><p class="text-muted mb-2">@d.Department</p><p class="mb-1">@d.Phone</p><p class="mb-3">@d.Email</p><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@d.Id">View profile</a>@if(User.IsInRole("Admin")){<a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@d.Id">Edit</a>}</div></div></div>}</div>
@if(!Model.Any()){<div class="empty-state"><h4>No doctors found</h4><p class="text-muted">Try changing your search filters.</p></div>}
